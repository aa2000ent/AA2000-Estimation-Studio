# ─────────────────────────────────────────────────────────────
# Mistral API key — used directly in the browser (VITE_ prefix
# inlines it into the client bundle at build time).
# Set this in .env (local dev) or in Vercel → Settings →
# Environment Variables (production).
# ─────────────────────────────────────────────────────────────

VITE_MISTRAL_API_KEY=

# VITE_API_BASE_URL=http://localhost:8081
VITE_API_BASE_URL=https://aa2000backend-server.onrender.com
VITE_VERIFY_SESSION_URL=https://aa2000backend-server.onrender.com/security/session